# Copy once outside the frozen checkout; edit paths to match the H100 platform.
if [ -n "${BASH_SOURCE[0]:-}" ]; then
  export LH_ENV_FILE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
fi
export PYTHON=python
export INPUT_ROOT=/data/260010171/inputs-v1.8
export LH_RUN_ROOT=/data/260010171/results/lm-head-m16-20261116
export LH_CURVATURE_ROOT=/data/260010171/results/lm-head-curvature-m16-20261116
export GPUS=0,1,2,3
export MICRO_BATCH=16
export OBJECTIVE=G
export NANOGPT_SWANLAB=1
export SWANLAB_PROJ_NAME=nanogpt-lm-head
# Optional organization workspace; leave unset for your personal workspace.
# export SWANLAB_WORKSPACE=your-workspace
# Supply SWANLAB_API_KEY through the platform's secret environment settings.
# K only: auto-populated when initial curvature-check passes (requires LH_ENV_FILE):
# export K_STATISTICS=/data/260010171/results/lm-head-curvature-m16-20261116/init-check-32k/K-approved.pt
